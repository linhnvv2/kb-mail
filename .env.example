# Microsoft Graph access token (delegated, scopes: Mail.Read, Mail.Send)
# Lấy nhanh từ Graph Explorer: https://developer.microsoft.com/graph/graph-explorer
GRAPH_TOKEN=

# Tên folder cần đọc khi chạy fetch-emails (vd: Inbox hoặc tên folder con)
MAIL_FOLDER=Inbox

# Số ngày gần nhất cần lấy mail
MAIL_DAYS=30

# Chu kỳ chạy job khi dùng --watch (phút)
JOB_INTERVAL_MINUTES=10

# ===== LLM (AI chat + tự phân loại) — API tương thích OpenAI =====
# LM Studio (mặc định): bật Local Server trong LM Studio, giữ nguyên các giá trị dưới
# Ollama:   LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=llama3
# OpenAI:   LLM_BASE_URL=https://api.openai.com/v1  LLM_API_KEY=sk-...  LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=lm-studio
LLM_MODEL=local-model
